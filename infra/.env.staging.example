# Kolmena — Staging environment variables
# Copy to .env.staging and fill in the blanks before deploying
# Never commit .env.staging — it's in .gitignore

# --- Required ---
JWT_SECRET=change-me-to-a-random-64-char-string

# --- Email (Resend) ---
# Leave blank in staging to fall back to console logging
RESEND_API_KEY=
EMAIL_FROM=Kolmena <noreply@kolmena.app>
APP_URL=http://127.0.0.1:3080

# --- Push Notifications (Expo) ---
# Optional in staging — set for production rate limits
EXPO_ACCESS_TOKEN=

# --- Storage (Cloudflare R2) ---
# Leave all blank to use local filesystem storage in staging
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kolmena
